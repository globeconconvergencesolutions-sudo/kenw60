# KENW60 Project Hub – server settings. Copy to ".env" and fill in. Never commit or email the real .env file.

# Initial admin account – only used when the database is empty (fresh install).
ADMIN_EMAIL=admin@globeconcs.com
ADMIN_PASSWORD=

# Largest single upload in MB
MAX_UPLOAD_MB=2048

# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# Public address of the hub – used in password-reset emails. Required for reset emails on a public server.
SITE_URL=https://kenw60.globeconcs.com

# Outgoing mail (password reset). Use a dedicated company mailbox such as noreply@globeconcs.com.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
